DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omnicanal
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omnicanal_test
# Secreto para firmar los OTP. Genera uno con: openssl rand -hex 32
OTP_SECRET=cambia-esto-en-produccion
# Opcional: con esta llave se activa la IA (Claude); sin ella todo funciona con reglas por palabras clave
ANTHROPIC_API_KEY=
# Modelo de Claude (por defecto claude-opus-5-5). AI_DISABLED=1 apaga la IA aunque haya llave (útil para la demo de resiliencia)
# AI_MODEL=claude-opus-5-5
# AI_DISABLED=1
# Firma de cookies de sesión. Genera uno con: openssl rand -hex 32
SESSION_SECRET=cambia-esto-en-produccion
# Simulador de WhatsApp en /whatsapp (confía en el número escrito). Pon 0 al usar el canal real.
WHATSAPP_SIMULATOR=1
# Llave que la app SWI manda en x-api-key a POST /api/integraciones/swi (mínimo 16 caracteres) y conexión con SWI.
SWI_URL=http://10.35.9.162:3000/api
SWI_API_KEY=demo-canales-2026
# Secreto compartido con WEB-CLINICA para recibir eventos de recepción en tiempo real.
CLINICA_WEBHOOK_SECRET=demo-clinica-events-2026
