DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omnicanal
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omnicanal_test
# Secreto para firmar los OTP. Genera uno con: openssl rand -hex 32
OTP_SECRET=cambia-esto-en-produccion
# Opcional: sin esta llave la IA usa reglas por palabras clave
ANTHROPIC_API_KEY=
# Firma de cookies de sesión. Genera uno con: openssl rand -hex 32
SESSION_SECRET=cambia-esto-en-produccion
# Simulador de WhatsApp en /whatsapp (confía en el número escrito). Pon 0 al usar el canal real.
WHATSAPP_SIMULATOR=1
